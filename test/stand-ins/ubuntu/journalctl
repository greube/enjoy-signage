#!/usr/bin/env bash
# Stand-in for "journalctl -u SVC [-n N] [-f]": shows the service's output.
. "$(dirname "$0")/log.sh" journalctl "$@"
svc=""; n=10; follow=0
while [ $# -gt 0 ]; do case "$1" in -u) svc=${2%.service}; shift ;; -n) n=$2; shift ;; -f) follow=1 ;; esac; shift; done
exec tail -n "$n" $([ $follow = 1 ] && echo -F) "/var/log/stand-in-$svc.log"
